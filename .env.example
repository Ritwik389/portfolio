# Use the full public website URL, including a GitHub Pages repository path.
NEXT_PUBLIC_SITE_URL=https://portfolio-pi-silk-48.vercel.app
# Empty for Vercel/Netlify; e.g. /portfolio for a GitHub Pages project site.
NEXT_PUBLIC_BASE_PATH=
# Set to 1 only for a static GitHub Pages export (ratings refresh at build time).
PORTFOLIO_STATIC_EXPORT=0
# Web3Forms keys are public identifiers, not secret credentials.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=737db4f4-8e52-467b-965a-82ba064bac13
